# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real credentials are never committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite

# Uploads
/public/uploads/

# Local model/runtime caches
/.cache/
/.huggingface/
/.transformers-cache/

# Research execution artifacts that may contain provider output or sealed test data
/benchmark/distillation/raw_responses/
/benchmark/distillation/private_external/
/benchmark/distillation/secrets/
/benchmark/distillation/checkpoints/
/benchmark/distillation/logs/

# Training outputs and large model artifacts
/training/**/checkpoints/
/training/**/runs/
/training/**/outputs/
*.onnx
*.safetensors
*.ckpt

# Local credentials and signing material
*.key
*.p12
*.pfx
