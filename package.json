{
  "name": "tmp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "benchmark": "npx tsx --env-file=.env.local scripts/benchmark.ts",
    "research:test": "vitest run lib/research/e5-distillation/__tests__",
    "research:validate": "npx tsx scripts/validate_distillation_protocol.ts",
    "research:human-reference:build:v2": "npx tsx scripts/build_human_reference_v2.ts",
    "research:human-reference:validate": "npx tsx scripts/validate_human_reference.ts --input benchmark/distillation/human_reference/human_reference_v2.csv --out benchmark/distillation/human_reference/validation_report_v2.json",
    "research:human-reference:validate:v1": "npx tsx scripts/validate_human_reference.ts --input benchmark/distillation/human_reference/human_reference_v1.csv",
    "research:judge:build-reference": "npx tsx scripts/build_judge_selection_reference.ts",
    "research:judge:smoke": "npx tsx --env-file=.env.local scripts/groq_judge_smoke.ts",
    "research:judge:smoke:live": "npx tsx --env-file=.env.local scripts/groq_judge_smoke.ts --live",
    "research:judge:run-selection": "npx tsx --env-file=.env.local scripts/run_judge_selection.ts",
    "research:judge:preflight": "npx tsx --env-file=.env.local scripts/run_judge_selection.ts --preflight",
    "research:judge:evaluate": "npx tsx scripts/evaluate_judge_selection.ts",
    "research:judge:finalize": "npx tsx scripts/finalize_judge_selection.ts",
    "research:judge:gemini:preflight": "npx tsx --env-file=.env.local scripts/run_gemini_judge_supplemental.ts --preflight",
    "research:judge:gemini:run": "npx tsx --env-file=.env.local scripts/run_gemini_judge_supplemental.ts",
    "research:judge:gemini:evaluate": "npx tsx scripts/evaluate_gemini_judge_supplemental.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.116.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
